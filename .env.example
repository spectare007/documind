# --- DocuMind backend ---
DOCUMIND_API_KEY=documind-dev-key                # bearer token; OpenWebUI uses it as the OpenAI API key; change this for anything beyond local dev
DOCUMIND_DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
DOCUMIND_OLLAMA_BASE_URL=http://localhost:11434
DOCUMIND_PHOENIX_BASE_URL=http://localhost:6006
DOCUMIND_LLM_MODEL=qwen2.5:3b                    # generation model (CPU-friendly)
DOCUMIND_EMBED_MODEL=nomic-embed-text            # 768-dim embeddings
DOCUMIND_EMBED_DIM=768                           # embedding vector dimensionality; must match embed_model's output size
DOCUMIND_JUDGE_MODEL=qwen2.5:7b                  # RAGAs evaluation judge
DOCUMIND_LLM_TIMEOUT_SECONDS=180.0               # per-request timeout (seconds) for LLM calls
DOCUMIND_PIPELINE_MODE=agentic                   # agentic | simple (naive RAG bypass)
DOCUMIND_RETRIEVAL_TOP_K=6
DOCUMIND_MAX_RETRIEVAL_ATTEMPTS=2                # max retries for the agentic retrieval step before giving up
DOCUMIND_MAX_GENERATION_ATTEMPTS=2               # max retries for the agentic generation step before giving up
DOCUMIND_REQUEST_BUDGET_SECONDS=300.0            # whole-request wall clock for agentic mode; stops retrying and returns the best answer so far
DOCUMIND_CHAT_STREAM_MAX_WORKERS=4               # thread pool size for streaming /v1/chat/completions pipeline runs
DOCUMIND_DATA_DIR=data/documents                 # source directory scanned for documents to ingest
DOCUMIND_PROMPTS_DIR=prompts                     # directory containing agent/prompt template files
DOCUMIND_CHUNK_MAX_TOKENS=512                    # max tokens per chunk when splitting documents for embedding
DOCUMIND_VECTOR_TABLE_NAME=rag_chunks            # Postgres table name used to store chunk embeddings

# --- docker-compose only ---
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
